# 서버 전용 키 — .env.local에 두고 절대 커밋하지 말 것. 키가 없어도 해당 기능만 비활성 안내가 뜬다.
BUILDING_HUB_API_KEY=        # 건축물대장 (국토교통부 건축HUB) — 상세 패널 건축 정보
RESEND_API_KEY=              # 오늘의 접점 메일 발송 (Resend)
NOTIFY_EMAIL_FROM=           # 도메인 인증 후 발신 주소 (미설정 시 onboarding@resend.dev)
SEOUL_DATA_API_KEY=          # 서울시 실시간 도시데이터 — 홍보 포인트
SESSION_SECRET=              # 세션 서명 비밀키 — 프로덕션 필수 (미설정 시 개발용 기본값)
CRON_SECRET=                 # Vercel Cron 인증 (선택)
NEXT_PUBLIC_APP_URL=         # 메일 링크 기준 URL (배포 도메인)
NEXT_PUBLIC_KAKAO_MAP_KEY=   # 카카오맵 JavaScript 키 — 접점 지도
ANTHROPIC_API_KEY=           # Phase 5 챗봇 (예정)
